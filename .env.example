# Pseudogram API Configuration
API_KEY=your_pseudogram_api_key_here
PSEUDOGRAM_API_BASE_URL=https://pseudogram-api.onrender.com

# Database
DATABASE_PATH=linkplease.db

# Rate Limiter & Outbox
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60.0
MAX_RETRIES=5
BASE_RETRY_DELAY_SECONDS=2.0
WORKER_POLL_INTERVAL_SECONDS=0.25
RECONCILIATION_INTERVAL_SECONDS=2.0

# Webhook Security
ENFORCE_WEBHOOK_SIGNATURE=false
